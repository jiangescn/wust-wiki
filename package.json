    "generate": "nuxt generate",
    "preview": "nuxt preview --host 127.0.0.1",
    "preview:static": "node scripts/serve-static.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "check:content": "node scripts/check-content.mjs",
    "check:xupt": "node scripts/check-xupt-source.mjs"
  },
